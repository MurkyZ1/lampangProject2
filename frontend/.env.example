# ค่าเริ่มต้นใช้ข้อมูลตัวอย่างจากต้นฉบับ และตอบแชตแบบ DEMO (ไม่ใช่ AI จริง)
VITE_DATA_SOURCE=mock
VITE_CHAT_MODE=mock

# เมื่อทำ backend แล้วเปลี่ยนค่าเป็น api และกำหนด URL
# VITE_DATA_SOURCE=api
# VITE_CHAT_MODE=api
# VITE_API_BASE_URL=http://localhost:3000

# เพิ่มเติม: ข้อมูลตำบลและสถิติพืช (ค่าเริ่มต้นอ่านไฟล์ frontend/public/data)
VITE_AGRI_SOURCE=local
# ถ้าต่อฐานข้อมูลแล้วใช้ VITE_AGRI_SOURCE=api และ VITE_API_BASE_URL

# ใช้โมเดล Python (แชตตอบจากผลโมเดล): ตั้ง VITE_CHAT_MODE=api แล้วรัน uvicorn พอร์ต 8000 (vite proxy ส่ง /api/chat ไปให้เอง)
# VITE_CHAT_MODE=api

# ข้อมูลตำบลจาก backend Python (/api/tambons) ตั้งไว้ใน frontend/.env แล้ว
# VITE_AGRI_SOURCE=api
